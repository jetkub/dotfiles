git_prompt_info() {
  local current_pwd="$PWD"

  if [[ "$current_pwd" != "$_git_prompt_pwd" ]]; then
    _git_prompt_pwd="$current_pwd"

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
      _git_prompt_cache=""
      return
    fi

    local branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    [[ -z "$branch" ]] && { _git_prompt_cache=""; return; }

    local clean="%F{yellow}"
    local dirty="%F{red}"
    local reset="%f"
    local indicators=""

    # Quick dirty check
    if git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null; then
      _git_prompt_cache=" ${clean}(${branch})${reset}"
    else
      ! git diff --quiet 2>/dev/null && indicators="${indicators}*"
      ! git diff --cached --quiet 2>/dev/null && indicators="${indicators}+"
      _git_prompt_cache=" ${dirty}(${branch}${indicators})${reset}"
    fi
  fi

  echo "$_git_prompt_cache"
}
